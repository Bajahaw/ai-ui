# Required. 32 random bytes, base64-encoded: `openssl rand -base64 32`
# Encrypts provider API keys, ChatGPT tokens, MCP credentials and user secrets.
# Back it up separately from /app/data and never change it.
ENCRYPTION_KEY=

# Path to a file containing the key (e.g. a Docker secret). Used when ENCRYPTION_KEY is unset.
# ENCRYPTION_KEY_FILE=/run/secrets/ai_ui_encryption_key

# Signs session cookies. If unset, a random one is used and everyone is logged out on restart.
JWT_SECRET=

# Allow new sign-ups. Default: false outside development mode; true when ENV=dev.
# For a new deployment, enable temporarily to create the first account, then disable.
# ALLOW_REGISTRATION=true

# Allow provider, MCP, and http_request endpoints to use HTTP, loopback, or private
# network addresses. Default: false (public HTTPS endpoints only). This weakens SSRF
# protection and should only be enabled for trusted single-user or local installations.
# ALLOW_LOCAL_NETWORK=true

# Public base URL of this instance, e.g. https://ai.example.com. Used to build the
# MCP OAuth2 redirect URL (<PUBLIC_URL>/api/tools/mcp/oauth/callback). If unset,
# the URL the browser is using is assumed.
# PUBLIC_URL=

# Overrides the OAuth client id used for "Sign in with ChatGPT".
# CHATGPT_CLIENT_ID=

# dev: debug logging and non-Secure cookies (allows plain HTTP). Do not use in production.
# ENV=dev
