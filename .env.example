# Required. 32 random bytes, base64-encoded: `openssl rand -base64 32`
# Encrypts provider API keys, ChatGPT tokens, MCP credentials and user secrets.
# Back it up separately from /app/data and never change it.
ENCRYPTION_KEY=

# Path to a file containing the key (e.g. a Docker secret). Used when ENCRYPTION_KEY is unset.
# ENCRYPTION_KEY_FILE=/run/secrets/ai_ui_encryption_key

# Signs session cookies. If unset, a random one is used and everyone is logged out on restart.
JWT_SECRET=

# Set to false to disable new sign-ups (default: true).
# ALLOW_REGISTRATION=false

# Overrides the OAuth client id used for "Sign in with ChatGPT".
# CHATGPT_CLIENT_ID=

# dev: debug logging and non-Secure cookies (allows plain HTTP). Do not use in production.
# ENV=dev
